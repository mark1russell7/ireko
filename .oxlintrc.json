{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest", "react"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "oxc/no-map-spread": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/consistent-return": "off",
    "import/no-cycle": "error",
    "eslint/no-underscore-dangle": "off",
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expectTypeOf", "expectGolden", "fc.assert"] }
    ],
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@fontsource-variable/*"] }
    ]
  },
  "ignorePatterns": [
    "packages/cli/**",
    "external/**",
    "docs/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "packages/site/.astro/**"
  ],
  "overrides": [
    {
      "files": ["**/*.bench.ts"],
      "rules": {
        "vitest/expect-expect": "off"
      }
    },
    {
      "files": ["packages/site/e2e/**", "packages/site/scripts/**"],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": ["packages/site/*.mjs", "packages/site/scripts/**", "packages/site/src/content.config.ts", "packages/ireko/scripts/**"],
      "rules": {
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.bench.ts"],
      "rules": {
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
