{
  "$schema": "https://json.schemastore.org/package",
  "name": "@ireko/bench",
  "version": "0.1.0",
  "private": true,
  "description": "The bench of relaxForces of ireko: fixed scenes, a fresh process for each arm, and the verdicts of rigor-bench.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "bench": "node src/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/rigor-bench": "^0.2.60",
    "@mark1russell7/rigor-generators": "^0.2.0",
    "@mark1russell7/rigor-statistics": "^0.2.12",
    "ireko": "workspace:*",
    "ireko-base": "npm:ireko@0.2.4"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
