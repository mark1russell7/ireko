{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "mutate": [
    "src/core/**/*.ts",
    "!src/core/**/*.test.ts",
    "!src/core/**/*.bench.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": null
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "tsconfigFile": "",
  "commandRunner": {
    "command": "npx vitest run --bail 1"
  }
}
