{
  "$schema": "https://json.schemastore.org/package",
  "name": "ireko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text/index.ts",
    "./svg": "./src/svg/index.ts",
    "./dom": "./src/dom/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./render": "./src/render/index.ts",
    "./react": "./src/react/index.tsx",
    "./xyflow": "./src/xyflow/index.tsx",
    "./examples": "./src/examples/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p tsconfig.test.json",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@xyflow/react": "^12.12.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "description": "Composable graph and tree layout for TypeScript. Select a layout for each container, and get boxes and routed edges for any renderer.",
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
