{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mark1russell7/cue/ts/config/ts.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "declaration": true,
    "isolatedDeclarations": true,
    "types": []
  },
  "include": [
    "src/core/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.bench.ts"
  ]
}
