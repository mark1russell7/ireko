---
/**
 * The cards of the home page. The build lays out a small example for each card, so each card shows real output of
 * ireko as static SVG, with no script.
 */
import { fitText, layout, type LayoutInput, type LayoutOptions } from "ireko";
import { LayoutSvg } from "ireko/react";
import { parse } from "ireko/text";
import { href } from "../lib/site.ts";

interface Card {
  readonly title: string;
  readonly text: string;
  readonly link: string;
  readonly source: string;
  readonly options?: LayoutOptions;
}

const cards: readonly Card[] = [
  {
    title: "Two passes, no overlaps",
    text: "The engine measures each subtree before it places it. A large subtree gets a large cell.",
    link: "design/two-passes/",
    source: "r { a { a1 a2 a3 } b nested { b1 b2 b3 b4 } c { c1 } }",
  },
  {
    title: "A strategy for each container",
    text: "A grid of rings of grids: each container selects its own layout and its own mode.",
    link: "learn/strategies/",
    source: "hub radial nested { g1 nested { a b c d } g2 nested { e f g h } g3 nested { i j k l } }",
  },
  {
    title: "Tidy trees",
    text: "The tree strategy packs each subtree by its shape. A small team fits under the edge of a large one.",
    link: "learn/strategies/#tree",
    source: "ceo tree { cto tree { web tree { ui api } infra tree { db net ops } } cfo tree { fin } coo tree { sales tree { n s e w } hr } }",
    options: { router: "orthogonal" },
  },
  {
    title: "Flowcharts",
    text: "The layers strategy follows the edges between the children. A cycle turns around, and a stage can nest.",
    link: "learn/strategies/#layers",
    source: "ci nested layers(side: right) { push lint test pack deploy }\npush -> lint\npush -> test\nlint -> pack\ntest -> pack\npack -> deploy",
    options: { router: "orthogonal" },
  },
  {
    title: "Edges around boxes",
    text: "The avoid router draws horizontal and vertical segments that go around the other boxes.",
    link: "learn/edges/#routers",
    source: "sys nested grid(columns: 3) { a b c d e f g h i }\na -> i\ng -> c\nb -> h",
    options: { router: "avoid" },
  },
  {
    title: "React Flow sub-flows",
    text: "Give layoutFlow your nodes and edges. Groups get a size, and children get positions inside them.",
    link: "guides/react-flow/",
    source: "flow nested { group nested { a b c } other nested { d e } }\na -> d",
  },
];

// Each box fits its label (fitText), with a small padding for the small cards.
const options: LayoutOptions = { spacing: 10, header: 20, measure: fitText({ padding: { x: 7, y: 3 }, minWidth: 30 }) };
const shown = cards.map((card) => {
  const r = parse(card.source);
  if (!r.ok) throw new Error(`Showcase: ${r.error.message}`);
  const input: LayoutInput = r.input;
  return { card, out: layout(input, { ...options, ...card.options }) };
});
---

<div class="ik-cards">
  {
    shown.map(({ card, out }) => (
      <a class="ik-card" href={href(card.link)}>
        <div class="ik-card-art ik-svg ik-paper" aria-hidden="true">
          <LayoutSvg layout={out} padding={10} />
        </div>
        <div class="ik-card-body">
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </div>
      </a>
    ))
  }
</div>
