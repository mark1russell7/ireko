{
  "$schema": "https://json.schemastore.org/package",
  "name": "ireko-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @ireko/site dev",
    "build": "pnpm --filter ireko build",
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:ste": "ste-lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test && pnpm lint:ste",
    "check:api": "api-report check",
    "dump:src": "cd packages/ireko/src && node ../../../external/concat-src/concat-src.js ../../../src-catalog.md",
    "test:coverage": "pnpm --filter ireko test:coverage",
    "size": "pnpm --filter ireko size",
    "check:package": "pnpm --filter ireko build && pnpm --filter ireko size && pnpm --filter ireko smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mark1russell7/api-report": "^0.5.3",
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/ste-lint": "github:mark1russell7/ste-lint",
    "@mark1russell7/template-cli": "^0.1.2",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "apiReport": {
    "packages": [
      "packages/ireko"
    ],
    "pages": [
      {
        "package": "packages/ireko",
        "pages": [
          "packages/site/src/content/docs/reference/api.mdx"
        ]
      }
    ]
  }
}
